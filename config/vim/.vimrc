syntax enable
set number
set ruler
set cursorline
set cursorcolumn
filetype plugin indent on
set modelines=0
set noerrorbells
set visualbell
set encoding=utf-8
set t_Co=256
set background=dark
set noswapfile
set hlsearch
set incsearch
set tabstop=4
set shiftwidth=4
set expandtab
let g:solarized_termcolors=256
let g:solarized_termtrans=1
" colorscheme solarized