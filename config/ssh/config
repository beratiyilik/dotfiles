# default settings for all hosts
Host *
    PreferredAuthentications publickey
    IdentitiesOnly no
    AddKeysToAgent no
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# ssh config for vps
Host nebulacore
    HostName ssh.nebulacore.beratiyilik.com
    User berat
    Port 22

