# Common variables. Loaded into the shell environment (shell/common/exports.sh)
# and also used during template rendering (core/py/template.py).
#
# Format: KEY=value
#   - NO 'export' keyword (for parity with the Python parser)
#   - do not expect shell expansion (values are plain strings)
#
# Use vars/local.env for machine-specific / secret values (it is gitignored).

# Example variable — available to the shell environment and to any {{TEMPLATE}}
# files rendered by core/py/template.py. (No template currently consumes it.)
SSH_IDENTITY=~/.ssh/id_ed25519

# Local Ollama defaults consumed by tools/ai_rename. Override the endpoint or model
# per machine in vars/local.env if your setup differs.
AI_DEFAULT_SMALL_MODEL=qwen2.5-coder:7b
AI_API_URL=http://localhost:11434/api/generate
