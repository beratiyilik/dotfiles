# vars/local.env.sample — committed template for vars/local.env
#
# Copy to vars/local.env and fill in your values:
#   cp vars/local.env.sample vars/local.env
#
# vars/local.env is gitignored and never committed.
# Format: KEY=value — no 'export', no shell expansion, no quotes needed.
# Loaded after vars/common.env (overrides it). Also consumed by
# core/py/template.py for {{KEY}} substitution in .tmpl files.
#
# ─── Credentials ────────────────────────────────────────────────────────────
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...
# CLAUDE_API_KEY=sk-ant-...
# NPM_ACCESS_TOKEN=npm_...
#
# ─── Feature flags (override vars/common.env defaults) ──────────────────────
# DOTFILES_ENABLE_NVM=false
# DOTFILES_ENABLE_GIT_HELPERS=false
# DOTFILES_ENABLE_AWS_HELPERS=true
# DOTFILES_ENABLE_ESP_IDF_HELPERS=true
#
# ─── Tool overrides ─────────────────────────────────────────────────────────
# AI_API_URL=http://192.168.1.100:11434/api/generate
# AI_DEFAULT_SMALL_MODEL=llama3.2:3b
# SSH_IDENTITY=~/.ssh/id_ed25519_work
