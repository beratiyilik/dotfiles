#!/usr/bin/env bash
# =============================================================================
# dotfiles — dotfiles CLI
#
# Compatible: bash 3.2+, zsh 5.0+
# Usage: dotfiles <command> [options]
#
# Commands:
#   init       Bootstrap the dotfiles installation
#   doctor     Check installation health
#   defaults   Apply macOS system preferences  (macOS only)
#   backup     Create a system backup          (macOS only)
#   help       Show this help
# =============================================================================

DOTFILES_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
export DOTFILES_DIR

# ── colors ────────────────────────────────────────────────────────────────────
if [ -t 1 ] && command -v tput >/dev/null 2>&1 \
   && _nc="$(tput colors 2>/dev/null)" && [ "${_nc:-0}" -ge 8 ]; then
  R=$'\033[0m'  B=$'\033[1m'   G=$'\033[0;32m'  C=$'\033[0;36m'
  Y=$'\033[0;33m' RE=$'\033[0;31m' D=$'\033[2m' BG=$'\033[1;32m'
else
  R='' B='' G='' C='' Y='' RE='' D='' BG=''
fi

# ── top-level help ────────────────────────────────────────────────────────────
_show_help() {
  printf '\n%sDotfiles CLI%s\n\n' "$B$C" "$R"
  printf 'Usage: %s <command> [options]\n\n' "$(basename "$0")"
  printf 'Commands:\n'
  printf '  init       Bootstrap the dotfiles installation\n'
  printf '  doctor     Check installation health\n'
  printf '  defaults   Apply macOS system preferences  (macOS)\n'
  printf '  backup     Create a system backup          (macOS)\n'
  printf '  help       Show this help\n'
  printf '\n'
  printf 'Run %s <command> --help for command-specific options.\n' "$(basename "$0")"
  printf '\nDotfiles: %s%s%s\n\n' "$D" "$DOTFILES_DIR" "$R"
}

# =============================================================================
# init command helpers
# =============================================================================

# Global flags — set by _cmd_init argument parsing, consumed by helpers below.
DRY_RUN=0
FORCE=0

_info()    { printf '%s==>%s  %s\n'         "$B$C" "$R" "$*"; }
_ok()      { printf '%s[ok]%s  %s\n'        "$G"   "$R" "$*"; }
_skip()    { printf '%s[--]  %s%s\n'        "$D"   "$*" "$R"; }
_warn()    { printf '%s[!!]%s  %s\n'        "$Y"   "$R" "$*"; }
_dry()     { printf '%s[dry] would: %s%s\n' "$D"   "$*" "$R"; }
_section() {
  local _t="$*"
  printf '\n%s── %s ' "$B" "$_t"
  printf '%0.s─' {1..20}
  printf '%s\n' "$R"
}

# _ask "Question" [y|n]  →  0=yes  1=no
_ask() {
  local _q="$1" _def="${2:-n}" _hint _ans
  [ "$_def" = "y" ] && _hint="[Y/n]" || _hint="[y/N]"
  if [ "$FORCE" = "1" ]; then
    printf '  %s?%s  %s %s → %s (auto)\n' "$Y" "$R" "$_q" "$_hint" "$_def"
    [ "$_def" = "y" ] && return 0 || return 1
  fi
  printf '  %s?%s  %s %s ' "$Y" "$R" "$_q" "$_hint"
  read -r _ans </dev/tty
  _ans="${_ans:-$_def}"
  case "$_ans" in [Yy]*) return 0 ;; *) return 1 ;; esac
}

# _link <src> <dst> [chmod-mode]
#   Correct symlink already present → silent skip.
#   Existing file/wrong-link → backup (.bak) then re-link.
_link() {
  local _src="$1" _dst="$2" _mode="${3:-}"

  if [ ! -e "$_src" ]; then
    _warn "Source missing, skipping: $_src"
    return 0
  fi

  if [ -L "$_dst" ] && [ "$(readlink "$_dst")" = "$_src" ]; then
    _skip "$_dst"
    return 0
  fi

  if [ "$DRY_RUN" = "1" ]; then
    if [ -e "$_dst" ] || [ -L "$_dst" ]; then
      _dry "backup $_dst → $_dst.bak"
    fi
    _dry "ln -sf $_src  →  $_dst"
    return 0
  fi

  if [ -e "$_dst" ] || [ -L "$_dst" ]; then
    _warn "Backing up: $_dst → $_dst.bak"
    cp -Lfv "$_dst" "$_dst.bak" 2>/dev/null || true
    unlink "$_dst" 2>/dev/null || rm -rf "$_dst" 2>/dev/null || true
  fi

  mkdir -p "$(dirname "$_dst")"
  ln -sf "$_src" "$_dst"
  [ -n "$_mode" ] && chmod "$_mode" "$_dst"
  _ok "$_dst  →  $_src"
}

_ensure_dirs() {
  local _d
  if [ "$DRY_RUN" = "1" ]; then
    for _d in "${DIRS[@]}"; do _dry "mkdir -p ~/$_d"; done
    _dry "mkdir -p ~/.ssh && chmod 700 ~/.ssh"
    return 0
  fi
  for _d in "${DIRS[@]}"; do mkdir -p "$HOME/$_d"; done
  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"
}

_install_brew() {
  if command -v brew >/dev/null 2>&1; then _skip "Homebrew already installed"; return 0; fi
  _ask "Homebrew is not installed — install it now?" "y" || return 0
  if [ "$DRY_RUN" = "1" ]; then _dry "NONINTERACTIVE=1 /bin/bash -c <homebrew-install.sh>"; return 0; fi
  _info "Installing Homebrew..."
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  [ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
  _ok "Homebrew installed"
}

_install_brew_packages() {
  local _brewfile="$DOTFILES_DIR/config/homebrew/Brewfile"
  command -v brew >/dev/null 2>&1 || { _warn "brew not found — skipping Brewfile"; return 0; }
  [ -f "$_brewfile" ]             || { _warn "Brewfile not found: $_brewfile";     return 0; }
  _ask "Install packages from Brewfile? (may take a while)" "y" || return 0
  if [ "$DRY_RUN" = "1" ]; then _dry "brew bundle --file=$_brewfile"; return 0; fi
  _info "Running brew bundle..."
  if brew bundle --file="$_brewfile"; then
    _ok "Brew packages installed"
  else
    _warn "brew bundle finished with warnings"
  fi
}

_install_omz() {
  if [ -d "$HOME/.oh-my-zsh" ]; then _skip "oh-my-zsh already installed"; return 0; fi
  _ask "Install oh-my-zsh?" "y" || return 0
  if [ "$DRY_RUN" = "1" ]; then _dry "sh -c <ohmyzsh-install.sh> -- --unattended"; return 0; fi
  _info "Installing oh-my-zsh..."
  sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" \
    "" --unattended
  _ok "oh-my-zsh installed"
}

_clone_if_missing() {
  local _label="$1" _repo="$2" _dest="$3"
  if [ -d "$_dest" ]; then _skip "$_label"; return 0; fi
  if [ "$DRY_RUN" = "1" ]; then _dry "git clone --depth=1 $_repo $_dest"; return 0; fi
  _info "Cloning $_label..."
  if git clone --depth=1 "$_repo" "$_dest" 2>/dev/null; then
    _ok "$_label"
  else
    _warn "Failed to clone $_label"
  fi
}

_install_omz_plugins() {
  [ -d "$HOME/.oh-my-zsh" ] || { _warn "oh-my-zsh not found — skipping plugins"; return 0; }
  local _custom="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
  local _entry _label _url _subpath
  for _entry in "${OMZ_PLUGINS[@]}"; do
    _label="${_entry%%|*}"
    _url="${_entry#*|}"; _subpath="${_url#*|}"; _url="${_url%%|*}"
    _clone_if_missing "$_label" "$_url" "$_custom/$_subpath"
  done
}

_set_default_shell() {
  local _zsh; _zsh="$(command -v zsh 2>/dev/null)"
  [ -z "$_zsh" ] && { _warn "zsh not found — skipping shell change"; return 0; }
  [ "$SHELL" = "$_zsh" ] && { _skip "Default shell is already zsh ($SHELL)"; return 0; }
  _ask "Change default shell to zsh ($_zsh)?" "y" || return 0
  if [ "$DRY_RUN" = "1" ]; then _dry "chsh -s $_zsh"; return 0; fi
  if ! grep -qxF "$_zsh" /etc/shells 2>/dev/null; then
    _info "Adding $_zsh to /etc/shells (needs sudo)"
    printf '%s\n' "$_zsh" | sudo tee -a /etc/shells >/dev/null
  fi
  chsh -s "$_zsh"
  _ok "Default shell set to $_zsh"
}

_seed_zsh_history() {
  local _seed="$DOTFILES_DIR/shell/zsh/.zsh_history_seed"
  local _hist="$HOME/.zsh_history"
  [ -f "$_seed" ] || return 0
  if [ -f "$_hist" ] && [ -s "$_hist" ]; then
    _skip "$HOME/.zsh_history already exists and is non-empty"
    return 0
  fi
  _ask "Seed ~/.zsh_history from history seed file?" "y" || return 0
  if [ "$DRY_RUN" = "1" ]; then _dry "cp $_seed $_hist"; return 0; fi
  cp "$_seed" "$_hist"
  _ok "$HOME/.zsh_history seeded"
}

# =============================================================================
# init command
# =============================================================================

_cmd_init() {
  local SKIP_BREW=0 SKIP_OMZ=0 SKIP_SHELL=0

  for _arg in "$@"; do
    case "$_arg" in
      --dry-run)  DRY_RUN=1   ;;
      --force)    FORCE=1     ;;
      --no-brew)  SKIP_BREW=1 ;;
      --no-omz)   SKIP_OMZ=1  ;;
      --no-shell) SKIP_SHELL=1 ;;
      -h | --help)
        printf 'Usage: %s init [--dry-run] [--force] [--no-brew] [--no-omz] [--no-shell]\n\n' "$(basename "$0")"
        printf '  --dry-run   Preview all changes without applying them\n'
        printf '  --force     Auto-answer yes to all prompts\n'
        printf '  --no-brew   Skip Homebrew installation and Brewfile\n'
        printf '  --no-omz    Skip oh-my-zsh and plugins\n'
        printf '  --no-shell  Skip setting zsh as default shell\n'
        return 0
        ;;
      *)
        printf 'Unknown option: %s  (try: %s init --help)\n' "$_arg" "$(basename "$0")" >&2
        return 1
        ;;
    esac
  done

  if [ ! -f "$DOTFILES_DIR/dotfiles.conf" ]; then
    printf '%s[error]%s dotfiles.conf not found in %s\n' "$B$RE" "$R" "$DOTFILES_DIR" >&2
    return 1
  fi
  # shellcheck source=dotfiles.conf
  . "$DOTFILES_DIR/dotfiles.conf"

  printf '\n%sDotfiles Installer%s' "$B$C" "$R"
  [ "$DRY_RUN" = "1" ] && printf ' %s[dry-run — no changes will be made]%s' "$Y" "$R"
  printf '\n%sDotfiles: %s%s\n' "$D" "$DOTFILES_DIR" "$R"

  # 1 ── required dirs ────────────────────────────────────────────────────
  _section "Directories"
  _ensure_dirs

  # 2 ── symlinks ─────────────────────────────────────────────────────────
  _section "Dotfiles"
  local _entry _src _rest _dst _mode
  for _entry in "${SYMLINKS[@]}"; do
    _src="${_entry%%:*}"
    _rest="${_entry#*:}"; _dst="${_rest%%:*}"; _mode="${_rest#*:}"
    [ "$_mode" = "$_dst" ] && _mode=""
    _link "$DOTFILES_DIR/$_src" "$HOME/$_dst" "$_mode"
  done

  # 3 ── homebrew ─────────────────────────────────────────────────────────
  if [ "$SKIP_BREW" = "0" ]; then
    _section "Homebrew"
    _install_brew
    _install_brew_packages
  fi

  # 4 ── oh-my-zsh ────────────────────────────────────────────────────────
  if [ "$SKIP_OMZ" = "0" ]; then
    _section "Oh My Zsh"
    _install_omz
    _install_omz_plugins
  fi

  # 5 ── default shell ────────────────────────────────────────────────────
  if [ "$SKIP_SHELL" = "0" ]; then
    _section "Default Shell"
    _set_default_shell
  fi

  # 6 ── history seed ─────────────────────────────────────────────────────
  _section "History"
  _seed_zsh_history

  printf '\n%sDone!%s' "$BG" "$R"
  [ "$DRY_RUN" = "1" ] && printf '  %s(dry-run — no changes were made)%s' "$Y" "$R"
  printf '\n\n'
  printf '  Next steps:\n'
  printf '  1. Restart your terminal, or run: exec zsh\n'
  printf '  2. Verify symlinks:  ls -la ~ | grep "%s"\n' "$DOTFILES_DIR"
  printf '  3. Check SSH perms:  ls -la ~/.ssh/config\n'
  printf '  4. Health check:     %s doctor\n' "$0"
  printf '  5. macOS defaults:   %s defaults --help\n' "$0"
  printf '\n'
}

# =============================================================================
# dispatch
# =============================================================================

_cmd="${1:-help}"
shift 2>/dev/null || true

case "$_cmd" in
  init)
    _cmd_init "$@"
    ;;
  doctor)
    exec bash "$DOTFILES_DIR/scripts/doctor.sh" "$@"
    ;;
  defaults)
    exec zsh "$DOTFILES_DIR/scripts/macos/defaults.zsh" "$@"
    ;;
  backup)
    exec zsh "$DOTFILES_DIR/scripts/macos/backup.zsh" "$@"
    ;;
  help | --help | -h)
    _show_help
    ;;
  *)
    printf '%s[error]%s Unknown command: %s  (try: %s help)\n' "$B$RE" "$R" "$_cmd" "$(basename "$0")" >&2
    exit 1
    ;;
esac

## eof
